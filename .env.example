# NULL protocol environment template. Copy to .env.local (never commit real values).

# --- Database (Railway Postgres or any Postgres 14+) ---
DATABASE_URL=postgresql://user:***@host:5432/dbname

# --- Solana (mainnet-beta; use devnet for test deployments) ---
# Server-side RPC (Helius/QuickNode/etc. recommended).
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=***
# RPC the browser uses to read Group/Scope accounts directly. Must allow browser (CORS) requests;
# api.mainnet-beta.solana.com returns 403 to browsers.
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_NULL_PROGRAM_ID=EeESX96fLQvMgRLWU5Fm1HFMofiSNPeoyymCWLAsSJrS
NEXT_PUBLIC_SITE_URL=https://nullproof.lol

# --- Keys (JSON byte array as written by solana-keygen, or base58 secret) ---
# Group administrator: signs initialize_group / update_group_root / create_scope.
ISSUER_ADMIN_KEYPAIR=[1,2,3,...]
# Fee payer for sponsored verify_proof transactions. Keep it separate from the issuer.
RELAYER_KEYPAIR=[1,2,3,...]
# Relayer refuses work and health goes DEGRADED below this balance (lamports).
RELAYER_MIN_LAMPORTS=20000000

# --- Admin API ---
# Bearer token for /api/admin/*. Generate: openssl rand -hex 24
ADMIN_TOKEN=change-me
# Salt for hashed rate-limit buckets (IPs are never stored in clear).
RELAY_SALT=change-me-too
RELAY_LIMIT_PER_HOUR=20
RELAY_GLOBAL_LIMIT_PER_MINUTE=30

# --- Project links (all optional) ---
NEXT_PUBLIC_TOKEN_CA=
NEXT_PUBLIC_TOKEN_NOTE=
NEXT_PUBLIC_PUMP_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DOCS_URL=/protocol
NEXT_PUBLIC_GITHUB_URL=
